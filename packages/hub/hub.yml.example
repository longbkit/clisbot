workspace:
  repos:
    - repo: owner/repo
      path: /workspace/repo
  cwd: /workspace/repo
triggers:
  - name: paseo-mention
    on:
      issue_comment:
        contains: "@paseo"
        from_users: []
      pull_request_review_comment:
        contains: "@paseo"
        from_users: []
      pull_request_review:
        contains: "@paseo"
        from_users: []
      issues:
        contains: "@paseo"
        from_users: []
    agent:
      provider: codex/gpt-5.5
      mode: full-access
    prompt: |
      Handle this trigger in the configured workspace.
