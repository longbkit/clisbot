{
  "name": "@getpaseo/hub",
  "version": "0.7.0",
  "description": "Self-hosted automation for Paseo daemons",
  "homepage": "https://paseo.sh/docs/hub",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getpaseo/hub.git"
  },
  "bin": {
    "paseo-hub": "bin/paseo-hub.js"
  },
  "files": [
    "bin",
    "dist",
    ".output",
    "drizzle"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "npm run build:node && npm run build:start",
    "prepack": "npm run build",
    "release:check": "npm run test:release && npm run typecheck && npm run lint && npm run format:check && npm run build && npm pack --dry-run",
    "build:node": "tsgo -p tsconfig.json",
    "build:start": "vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:start && npm run typecheck:e2e",
    "typecheck:node": "tsgo --noEmit -p tsconfig.json",
    "typecheck:start": "tsgo --noEmit -p tsconfig.start.json",
    "typecheck:e2e": "tsgo --noEmit -p tsconfig.e2e.json",
    "start": "node dist/index.js",
    "test": "npm run test:scripts && vitest run",
    "test:scripts": "node --test scripts/release-metadata.node-test.mjs scripts/paseo-workspace.node-test.mjs",
    "test:release": "node --test scripts/release-metadata.node-test.mjs",
    "test:e2e:hub:source": "RUN_HUB_E2E=1 vitest run src/e2e/hub-foundation.e2e.test.ts src/e2e/hub-attachments.e2e.test.ts --bail=1",
    "test:e2e:hub:real-agent": "RUN_HUB_REAL_AGENT_E2E=1 vitest run src/e2e/hub-real-agent.e2e.test.ts --bail=1",
    "test:e2e:browser": "npm run build && playwright test",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "lint": "npm run lint:node && npm run lint:start",
    "lint:node": "oxlint --config oxlint.json --tsconfig tsconfig.json --ignore-pattern '**/*.tsx' --ignore-pattern '**/*.mjs' src",
    "lint:start": "oxlint --config oxlint.json --tsconfig tsconfig.start.json --ignore-pattern '**/*.mjs' src vite.config.ts drizzle.config.ts",
    "lint:fix": "npm run lint:node -- --fix && npm run lint:start -- --fix",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "scripts/check-drizzle.sh",
    "docker:smoke": "scripts/docker-smoke.sh"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@electric-sql/pglite": "^0.5.4",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scalar/api-reference-react": "^0.9.37",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.28",
    "ajv": "^8.20.0",
    "better-auth": "1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.25.0",
    "octokit": "^4.0.2",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "3.4.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/chai": "5.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.10",
    "lefthook": "^2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "0.22.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "7.3.6",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@types/chai": "5.0.1"
  }
}
