{
  "name": "@clisbot/channels-feishu",
  "version": "2.0.0",
  "description": "In-repo Feishu/Lark channel vertical (goal ledger slice 15). Ported from extensions/feishu/src@5d8067a4483: the Lark SDK client + tenant-token plumbing, the six feishu_* agent tool families, the WS long-connection / webhook transports, the send + card closure, and the Fusion boundary adapters. Third-party SDK is upstream's: @larksuiteoapi/node-sdk.",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "SYNC.md",
    "upstream-sync.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clisbot/channels-core": "2.0.0",
    "@clisbot/channels-markdown-core": "2.0.0",
    "@clisbot/channels-shared": "2.0.0",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.1",
    "typebox": "1.3.18",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "vitest": "^3.2.4"
  }
}
