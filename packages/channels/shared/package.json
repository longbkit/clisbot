{
  "name": "@clisbot/channels-shared",
  "version": "0.7.3-beta.1",
  "description": "Channel-agnostic contract + L3 inbound monitor for the in-repo channel verticals (blueprint docs/audits/2026-08-26-in-repo-channel-verticals.md §6.5)",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "SYNC.md",
    "upstream-sync.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sim": {
      "types": "./dist/sim/index.d.ts",
      "default": "./dist/sim/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clisbot/channels-core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "vitest": "^3.2.4"
  }
}
