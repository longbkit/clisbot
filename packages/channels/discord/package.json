{
  "name": "@clisbot/channels-discord",
  "version": "2.0.0",
  "description": "In-repo Discord channel vertical (goal ledger slice 13). Ported from extensions/discord/src@5d8067a4483: the hand-rolled Discord REST/gateway client (src/internal), the send/action/component/markdown closure, and the Fusion boundary adapters. Third-party SDKs are upstream's: discord-api-types, ws, typebox, mdast-util-from-markdown.",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "SYNC.md",
    "upstream-sync.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clisbot/channels-core": "2.0.0",
    "@clisbot/channels-markdown-core": "2.0.0",
    "@clisbot/channels-shared": "2.0.0",
    "discord-api-types": "0.38.54",
    "mdast-util-from-markdown": "2.0.3",
    "typebox": "1.3.18",
    "undici": "8.10.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.13",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "vitest": "^3.2.4"
  }
}
