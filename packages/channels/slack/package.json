{
  "name": "@clisbot/channels-slack",
  "version": "2.0.0",
  "description": "In-repo Slack channel vertical. Ported from OpenClaw `extensions/slack/src` at 5d8067a4483 (see upstream-sync.json / SYNC.md); the SDK stack matches upstream (@slack/web-api, @slack/socket-mode, @slack/types).",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "SYNC.md",
    "upstream-sync.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clisbot/channels-core": "2.0.0",
    "@clisbot/channels-markdown-core": "2.0.0",
    "@clisbot/channels-shared": "2.0.0",
    "@slack/bolt": "5.0.0",
    "@slack/socket-mode": "3.0.1",
    "@slack/types": "3.1.0",
    "@slack/web-api": "8.1.1",
    "get-east-asian-width": "1.6.0",
    "typebox": "1.3.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "vitest": "^3.2.4"
  }
}
