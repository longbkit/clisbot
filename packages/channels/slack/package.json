  "dependencies": {
    "@getpaseo/channels-core": "*",
    "@getpaseo/channels-shared": "*",
    "@slack/bolt": "5.0.0",
    "@slack/socket-mode": "3.0.1",
    "@slack/types": "3.1.0",
    "@slack/web-api": "8.1.1",
    "get-east-asian-width": "1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "vitest": "^3.2.4"
  }
}
