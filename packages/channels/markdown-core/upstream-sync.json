  "omitted": [
    {
      "upstream": "packages/normalization-core/src",
      "reason": "Only the modules the markdown-core sources import are carried under src/normalization-core (expect, record-coerce, number-coercion, string-coerce, error-coercion, utf16-slice). The rest of the package (agent-id, libphonenumber-backed phone-presentation, json-schema/typebox, result, stable-*, the index barrel, and the package's own tests) would add third-party dependencies with no consumer in the ported closure. Bare `@openclaw/normalization-core` imports are rewritten to the specific module instead of the barrel."
    },
    {
      "upstream": "packages/terminal-core/src",
      "reason": "Only `ansi.ts` + `ansi-sequences.ts` are carried under src/terminal-core; `table-layout.ts` imports `visibleWidth` from them. The rest of terminal-core is CLI rendering with no consumer here."
    }
  ],
  "deviations": [
    {
      "id": "D-MC-001",
      "file": "tsconfig.json",
      "reason": "`exactOptionalPropertyTypes` and `noPropertyAccessFromIndexSignature` are off in this package so the upstream source compiles unedited. OpenClaw's own tsconfig sets neither flag; turning them on would mean editing ported lines. `noUncheckedIndexedAccess` stays on, matching upstream.",
      "tests": ["src/ir.test.ts", "src/render.ts"]
    },
    {
      "id": "D-MC-002",
      "file": "package.json",
      "reason": "Fusion cannot add `packages/normalization-core` and `packages/terminal-core` as workspaces without editing the root package.json, so the modules the markdown-core sources need live under `src/normalization-core` and `src/terminal-core` in this package. Relative paths and file names below each upstream root are unchanged; the import rewrites are `@openclaw/normalization-core/<mod>` -> `./normalization-core/<mod>.js` and `../../terminal-core/src/<mod>.js` -> `./terminal-core/<mod>.js`.",
      "tests": ["src/tables.test.ts", "src/chunk-text.test.ts"]
    },
    {
      "id": "D-MC-003",
      "file": ".oxlintrc.json",
      "reason": "Nested oxlint override turning off `typescript/consistent-type-definitions`, `no-nested-ternary`, `complexity`, `max-depth`, `max-nested-callbacks` and `no-control-regex` for this package. They are stylistic, OpenClaw's lint config does not apply them, and enforcing them would mean editing every ported file. Correctness, suspicious and perf rules from the root config still apply.",
      "tests": []
    }
  ]
