{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string"
          },
          "senderId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["queued", "sending", "needs_review"]
          },
          "reason": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "attachments": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "forge_change_request"
                        },
                        "mimeType": {
                          "type": "string",
                          "const": "application/clisbot-forge-change-request"
                        },
                        "forge": {
                          "default": "github",
                          "type": "string"
                        },
                        "number": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "title": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "body": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "projectPath": {
                          "type": "string"
                        },
                        "baseRefName": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "headRefName": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["type", "mimeType", "number", "title", "url"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "forge_issue"
                        },
                        "mimeType": {
                          "type": "string",
                          "const": "application/clisbot-forge-issue"
                        },
                        "forge": {
                          "default": "github",
                          "type": "string"
                        },
                        "number": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "title": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "body": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "projectPath": {
                          "type": "string"
                        }
                      },
                      "required": ["type", "mimeType", "number", "title", "url"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "github_pr"
                        },
                        "mimeType": {
                          "type": "string",
                          "const": "application/github-pr"
                        },
                        "number": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "title": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "body": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "baseRefName": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "headRefName": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["type", "mimeType", "number", "title", "url"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "github_issue"
                        },
                        "mimeType": {
                          "type": "string",
                          "const": "application/github-issue"
                        },
                        "number": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "title": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "body": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["type", "mimeType", "number", "title", "url"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "text"
                        },
                        "mimeType": {
                          "type": "string",
                          "const": "text/plain"
                        },
                        "contextKind": {
                          "type": "string"
                        },
                        "sourceSession": {
                          "type": "object",
                          "properties": {
                            "agentId": {
                              "type": "string"
                            },
                            "epoch": {
                              "type": "string"
                            },
                            "seq": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": ["agentId", "epoch", "seq"]
                        },
                        "title": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "text": {
                          "type": "string"
                        },
                        "externalResource": {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string"
                            },
                            "providerLabel": {
                              "type": "string"
                            },
                            "resourceType": {
                              "type": "string"
                            },
                            "id": {
                              "type": "string"
                            },
                            "identifier": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string"
                            },
                            "url": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "provider",
                            "providerLabel",
                            "resourceType",
                            "id",
                            "identifier",
                            "title",
                            "url"
                          ]
                        }
                      },
                      "required": ["type", "mimeType", "text"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "review"
                        },
                        "mimeType": {
                          "type": "string",
                          "const": "application/clisbot-review"
                        },
                        "cwd": {
                          "type": "string"
                        },
                        "mode": {
                          "type": "string",
                          "enum": ["uncommitted", "base"]
                        },
                        "baseRef": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "comments": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "filePath": {
                                "type": "string"
                              },
                              "side": {
                                "type": "string",
                                "enum": ["old", "new"]
                              },
                              "lineNumber": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              "body": {
                                "type": "string"
                              },
                              "context": {
                                "type": "object",
                                "properties": {
                                  "hunkHeader": {
                                    "type": "string"
                                  },
                                  "targetLine": {
                                    "type": "object",
                                    "properties": {
                                      "oldLineNumber": {
                                        "anyOf": [
                                          {
                                            "type": "integer",
                                            "exclusiveMinimum": 0,
                                            "maximum": 9007199254740991
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      },
                                      "newLineNumber": {
                                        "anyOf": [
                                          {
                                            "type": "integer",
                                            "exclusiveMinimum": 0,
                                            "maximum": 9007199254740991
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      },
                                      "type": {
                                        "type": "string",
                                        "enum": ["add", "remove", "context"]
                                      },
                                      "content": {
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "oldLineNumber",
                                      "newLineNumber",
                                      "type",
                                      "content"
                                    ]
                                  },
                                  "lines": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "oldLineNumber": {
                                          "anyOf": [
                                            {
                                              "type": "integer",
                                              "exclusiveMinimum": 0,
                                              "maximum": 9007199254740991
                                            },
                                            {
                                              "type": "null"
                                            }
                                          ]
                                        },
                                        "newLineNumber": {
                                          "anyOf": [
                                            {
                                              "type": "integer",
                                              "exclusiveMinimum": 0,
                                              "maximum": 9007199254740991
                                            },
                                            {
                                              "type": "null"
                                            }
                                          ]
                                        },
                                        "type": {
                                          "type": "string",
                                          "enum": ["add", "remove", "context"]
                                        },
                                        "content": {
                                          "type": "string"
                                        }
                                      },
                                      "required": [
                                        "oldLineNumber",
                                        "newLineNumber",
                                        "type",
                                        "content"
                                      ]
                                    }
                                  }
                                },
                                "required": ["hunkHeader", "targetLine", "lines"]
                              }
                            },
                            "required": ["filePath", "side", "lineNumber", "body", "context"]
                          }
                        }
                      },
                      "required": ["type", "mimeType", "cwd", "mode", "comments"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "uploaded_file"
                        },
                        "id": {
                          "type": "string"
                        },
                        "fileName": {
                          "type": "string"
                        },
                        "mimeType": {
                          "type": "string"
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "path": {
                          "type": "string"
                        }
                      },
                      "required": ["type", "id", "fileName", "mimeType", "size", "path"]
                    }
                  ]
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "fileName": {
                      "type": "string"
                    },
                    "mimeType": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "relativePath": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "fileName", "mimeType", "size", "relativePath"]
                }
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "fileName": {
                      "type": "string"
                    },
                    "mimeType": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "relativePath": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "fileName", "mimeType", "size", "relativePath"]
                }
              },
              "fingerprint": {
                "type": "string"
              },
              "identity": {
                "type": "object",
                "properties": {
                  "actor": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["user", "automation", "system"]
                      },
                      "id": {
                        "type": "string"
                      },
                      "displayName": {
                        "type": "string"
                      },
                      "avatarUrl": {
                        "type": "string"
                      },
                      "hubOrigin": {
                        "type": "string"
                      },
                      "hubIdentity": {
                        "type": "string"
                      },
                      "organizationId": {
                        "type": "string"
                      },
                      "connectionId": {
                        "type": "string"
                      },
                      "memberId": {
                        "type": "string"
                      }
                    },
                    "required": ["kind", "id"]
                  },
                  "channel": {
                    "type": "object",
                    "properties": {
                      "hubOrigin": {
                        "type": "string"
                      },
                      "organizationId": {
                        "type": "string"
                      },
                      "connectionId": {
                        "type": "string"
                      },
                      "channelId": {
                        "type": "string"
                      },
                      "displayName": {
                        "type": "string"
                      },
                      "channel": {
                        "type": "string"
                      }
                    },
                    "required": ["hubOrigin", "organizationId", "connectionId", "channelId"]
                  },
                  "receivedAt": {
                    "type": "string"
                  }
                }
              }
            },
            "required": ["text", "files", "images", "fingerprint", "identity"]
          }
        },
        "required": ["id", "createdAt", "senderId", "state", "payload"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "revision", "items"],
  "additionalProperties": false
}
