    "__schema2": {
      "type": "object",
      "properties": {
        "oldLineNumber": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "newLineNumber": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": ["add", "remove", "context"]
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["oldLineNumber", "newLineNumber", "type", "content"]
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "minimum": 1,
      "$ref": "#/$defs/__schema3"
    }
