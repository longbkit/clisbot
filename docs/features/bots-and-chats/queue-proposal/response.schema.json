  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1048576
          },
          "images": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": ["data", "mimeType"]
            }
          },
          "attachments": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "forge_change_request"
                    },
                    "mimeType": {
                      "type": "string",
                      "const": "application/clisbot-forge-change-request"
                    },
                    "forge": {
                      "default": "github",
                      "type": "string"
                    },
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "body": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "projectPath": {
                      "type": "string"
                    },
                    "baseRefName": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "headRefName": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["type", "mimeType", "number", "title", "url"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "forge_issue"
                    },
                    "mimeType": {
                      "type": "string",
                      "const": "application/clisbot-forge-issue"
                    },
                    "forge": {
                      "default": "github",
                      "type": "string"
                    },
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "body": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "projectPath": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "mimeType", "number", "title", "url"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "github_pr"
                    },
                    "mimeType": {
                      "type": "string",
                      "const": "application/github-pr"
                    },
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "body": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "baseRefName": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "headRefName": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["type", "mimeType", "number", "title", "url"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "github_issue"
                    },
                    "mimeType": {
                      "type": "string",
                      "const": "application/github-issue"
                    },
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "body": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["type", "mimeType", "number", "title", "url"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "mimeType": {
                      "type": "string",
                      "const": "text/plain"
                    },
                    "contextKind": {
                      "type": "string"
                    },
                    "sourceSession": {
                      "type": "object",
                      "properties": {
                        "agentId": {
                          "type": "string"
