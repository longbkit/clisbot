                          },
                          "lineNumber": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "body": {
                            "type": "string"
                          },
                          "context": {
                            "type": "object",
                            "properties": {
                              "hunkHeader": {
                                "type": "string"
                              },
                              "targetLine": {
                                "type": "object",
                                "properties": {
                                  "oldLineNumber": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "exclusiveMinimum": 0,
                                        "maximum": 9007199254740991
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "newLineNumber": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "exclusiveMinimum": 0,
                                        "maximum": 9007199254740991
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "type": {
                                    "type": "string",
                                    "enum": ["add", "remove", "context"]
                                  },
                                  "content": {
                                    "type": "string"
                                  }
                                },
                                "required": ["oldLineNumber", "newLineNumber", "type", "content"]
                              },
                              "lines": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "oldLineNumber": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "exclusiveMinimum": 0,
                                          "maximum": 9007199254740991
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "newLineNumber": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "exclusiveMinimum": 0,
                                          "maximum": 9007199254740991
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "type": {
                                      "type": "string",
                                      "enum": ["add", "remove", "context"]
                                    },
                                    "content": {
                                      "type": "string"
                                    }
                                  },
                                  "required": ["oldLineNumber", "newLineNumber", "type", "content"]
                                }
                              }
                            },
                            "required": ["hunkHeader", "targetLine", "lines"]
                          }
                        },
                        "required": ["filePath", "side", "lineNumber", "body", "context"]
                      }
                    }
                  },
                  "required": ["type", "mimeType", "cwd", "mode", "comments"]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "uploaded_file"
                    },
                    "id": {
                      "type": "string"
                    },
                    "fileName": {
                      "type": "string"
                    },
                    "mimeType": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "id", "fileName", "mimeType", "size", "path"]
                }
              ]
            }
          },
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["queued", "sending", "needs_review"]
          },
          "reason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["text", "id", "state", "createdAt"]
      }
    }
  },
  "required": ["revision", "items"]
}
