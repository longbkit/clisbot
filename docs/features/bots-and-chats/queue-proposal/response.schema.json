                      },
                      "required": ["agentId", "epoch", "seq"]
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "externalResource": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "providerLabel": {
                          "type": "string"
                        },
                        "resourceType": {
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "identifier": {
                          "type": "string"
