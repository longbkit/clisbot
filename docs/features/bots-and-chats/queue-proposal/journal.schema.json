{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "chat_queue"
    },
    "epoch": {
      "$ref": "#/$defs/__schema0"
    },
    "seq": {
      "$ref": "#/$defs/__schema1"
    },
    "value": {
      "type": "object",
      "properties": {
        "recordVersion": {
          "type": "number",
          "const": 1
        },
        "chatId": {
          "$ref": "#/$defs/__schema0"
        },
        "previousRevision": {
          "$ref": "#/$defs/__schema2"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        },
        "nextQueueSeq": {
          "$ref": "#/$defs/__schema1"
        },
        "entry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/__schema3"
                },
                "revision": {
                  "$ref": "#/$defs/__schema1"
                },
                "contentDigest": {
                  "$ref": "#/$defs/__schema5"
                },
                "actor": {
                  "$ref": "#/$defs/__schema6"
                },
                "audience": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "direct"
                        },
                        "botId": {
                          "$ref": "#/$defs/__schema0"
                        }
                      },
                      "required": ["kind", "botId"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "group"
                        },
                        "mode": {
                          "type": "string",
                          "enum": ["open", "addressed"]
                        },
                        "botIds": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema0"
                          }
                        }
                      },
                      "required": ["kind", "mode", "botIds"],
                      "additionalProperties": false
                    }
                  ]
                },
                "outcome": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "queued"
                        }
                      },
                      "required": ["state"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "claimed"
                        },
                        "lease": {
                          "$ref": "#/$defs/__schema7"
                        }
                      },
                      "required": ["state", "lease"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "applied"
                        },
                        "transcript": {
                          "type": "object",
                          "properties": {
                            "messageId": {
                              "$ref": "#/$defs/__schema0"
                            },
                            "seq": {
                              "$ref": "#/$defs/__schema1"
                            }
                          },
                          "required": ["messageId", "seq"],
                          "additionalProperties": false
                        },
                        "deliveries": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema8"
                          }
                        },
                        "appliedAt": {
                          "$ref": "#/$defs/__schema4"
                        }
                      },
                      "required": ["state", "transcript", "deliveries", "appliedAt"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "canceled"
                        },
                        "canceledAt": {
                          "$ref": "#/$defs/__schema4"
                        }
                      },
                      "required": ["state", "canceledAt"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "failed"
                        },
                        "failedAt": {
                          "$ref": "#/$defs/__schema4"
                        },
                        "code": {
                          "type": "string",
                          "enum": [
                            "access_revoked",
                            "target_gone",
                            "content_unavailable",
                            "definitive_rejection",
                            "retry_exhausted"
                          ]
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["state", "failedAt", "code", "detail"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "const": "unknown"
                        },
                        "claimId": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "observedAt": {
                          "$ref": "#/$defs/__schema4"
                        },
                        "code": {
                          "type": "string",
                          "enum": ["host_restarted", "provider_outcome_unknown"]
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["state", "claimId", "observedAt", "code", "detail"],
                      "additionalProperties": false
                    }
                  ]
                },
                "contentRef": {
                  "$ref": "#/$defs/__schema9"
                }
              },
              "required": [
                "receipt",
                "revision",
                "contentDigest",
                "actor",
                "audience",
                "outcome",
                "contentRef"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "commandReceipt": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "queue"
                    },
                    "mutationId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "commandDigest": {
                      "$ref": "#/$defs/__schema5"
                    },
                    "actor": {
                      "$ref": "#/$defs/__schema6"
                    },
                    "recordedAt": {
                      "$ref": "#/$defs/__schema4"
                    },
                    "commandType": {
                      "type": "string",
                      "enum": [
                        "chat.message.enqueue.request",
                        "chat.message.edit.request",
                        "chat.message.cancel.request",
                        "chat.queue.reorder.request"
                      ]
                    },
                    "commandRef": {
                      "$ref": "#/$defs/__schema9"
                    },
                    "result": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "accepted"
                            },
                            "revision": {
                              "$ref": "#/$defs/__schema1"
                            },
                            "receipt": {
                              "anyOf": [
                                {
                                  "$ref": "#/$defs/__schema3"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "duplicate": {
                              "type": "boolean"
                            }
                          },
                          "required": ["status", "revision", "receipt", "duplicate"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "rejected"
                            },
                            "revision": {
                              "anyOf": [
                                {
                                  "$ref": "#/$defs/__schema2"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "error": {
                              "$ref": "#/$defs/__schema10"
                            }
                          },
                          "required": ["status", "revision", "error"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "mutationId",
                    "commandDigest",
                    "actor",
                    "recordedAt",
                    "commandType",
                    "commandRef",
                    "result"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "steer"
                    },
                    "mutationId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "commandDigest": {
                      "$ref": "#/$defs/__schema5"
                    },
                    "actor": {
                      "$ref": "#/$defs/__schema6"
                    },
                    "recordedAt": {
                      "$ref": "#/$defs/__schema4"
                    },
                    "commandType": {
                      "type": "string",
                      "const": "chat.message.steer.request"
                    },
                    "commandRef": {
                      "$ref": "#/$defs/__schema9"
                    },
                    "result": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "pending"
                            },
                            "messageId": {
                              "$ref": "#/$defs/__schema0"
                            },
                            "lease": {
                              "$ref": "#/$defs/__schema7"
                            }
                          },
                          "required": ["status", "messageId", "lease"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "applied"
                            },
                            "delivery": {
                              "$ref": "#/$defs/__schema8"
                            },
                            "transcript": {
                              "type": "object",
                              "properties": {
                                "messageId": {
                                  "$ref": "#/$defs/__schema0"
                                },
                                "seq": {
                                  "$ref": "#/$defs/__schema1"
                                }
                              },
                              "required": ["messageId", "seq"],
                              "additionalProperties": false
                            },
                            "duplicate": {
                              "type": "boolean"
                            }
                          },
                          "required": ["status", "delivery", "transcript", "duplicate"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "rejected"
                            },
                            "error": {
                              "$ref": "#/$defs/__schema10"
                            }
                          },
                          "required": ["status", "error"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "const": "unknown"
                            },
                            "messageId": {
                              "$ref": "#/$defs/__schema0"
                            },
                            "error": {
                              "$ref": "#/$defs/__schema10"
                            }
                          },
                          "required": ["status", "messageId", "error"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "mutationId",
                    "commandDigest",
                    "actor",
                    "recordedAt",
                    "commandType",
                    "commandRef",
                    "result"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "orderedMessageIds": {
          "anyOf": [
            {
              "maxItems": 128,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "discussion": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "discussionId": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "generation": {
                          "$ref": "#/$defs/__schema1"
                        },
                        "triggerMessageIds": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema0"
                          }
                        },
                        "mode": {
                          "type": "string",
                          "enum": ["open", "addressed"]
                        },
                        "round": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 20
                        },
                        "roundsMax": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 20
                        },
                        "spoke": {
                          "type": "boolean"
                        },
                        "waitingBotIds": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema0"
                          }
                        },
                        "current": {
                          "anyOf": [
                            {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "state": {
                                      "type": "string",
                                      "const": "claimed"
                                    },
                                    "botId": {
                                      "$ref": "#/$defs/__schema0"
                                    },
                                    "lease": {
                                      "$ref": "#/$defs/__schema7"
                                    },
                                    "clientMessageId": {
                                      "$ref": "#/$defs/__schema0"
                                    }
                                  },
                                  "required": ["state", "botId", "lease", "clientMessageId"],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "state": {
                                      "type": "string",
                                      "const": "running"
                                    },
                                    "botId": {
                                      "$ref": "#/$defs/__schema0"
                                    },
                                    "delivery": {
                                      "$ref": "#/$defs/__schema8"
                                    }
                                  },
                                  "required": ["state", "botId", "delivery"],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "state": {
                                      "type": "string",
                                      "const": "unknown"
                                    },
                                    "botId": {
                                      "$ref": "#/$defs/__schema0"
                                    },
                                    "claimId": {
                                      "$ref": "#/$defs/__schema0"
                                    },
                                    "clientMessageId": {
                                      "$ref": "#/$defs/__schema0"
                                    }
                                  },
                                  "required": ["state", "botId", "claimId", "clientMessageId"],
                                  "additionalProperties": false
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "discussionId",
                        "generation",
                        "triggerMessageIds",
                        "mode",
                        "round",
                        "roundsMax",
                        "spoke",
                        "waitingBotIds",
                        "current"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["value"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "recordVersion",
        "chatId",
        "previousRevision",
        "revision",
        "nextQueueSeq",
        "entry",
        "commandReceipt",
        "orderedMessageIds",
        "discussion"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/$defs/__schema1"
        },
        "timestamp": {
          "$ref": "#/$defs/__schema4"
        },
        "actor": {
          "$ref": "#/$defs/__schema6"
        },
        "channel": {
          "type": "object",
          "properties": {
            "hubOrigin": {
              "type": "string"
            },
            "organizationId": {
              "type": "string"
            },
            "connectionId": {
              "type": "string"
            },
            "channelId": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "channel": {
              "type": "string"
            }
          },
          "required": ["hubOrigin", "organizationId", "connectionId", "channelId"]
        }
      },
      "required": ["order", "timestamp"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "epoch", "seq", "value"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "minimum": 1,
      "$ref": "#/$defs/__schema2"
    },
    "__schema2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "messageId": {
          "$ref": "#/$defs/__schema0"
        },
        "queueSeq": {
          "$ref": "#/$defs/__schema1"
        },
        "acceptedAt": {
          "$ref": "#/$defs/__schema4"
        },
        "acceptedRevision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": ["messageId", "queueSeq", "acceptedAt", "acceptedRevision"],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "automation", "system"]
        },
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string"
        },
        "hubOrigin": {
          "type": "string"
        },
        "hubIdentity": {
          "type": "string"
        },
        "organizationId": {
          "type": "string"
        },
        "connectionId": {
          "type": "string"
        },
        "memberId": {
          "type": "string"
        }
      },
      "required": ["kind", "id"]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "claimId": {
          "$ref": "#/$defs/__schema0"
        },
        "hostBootId": {
          "$ref": "#/$defs/__schema0"
        },
        "expiresAt": {
          "$ref": "#/$defs/__schema4"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": ["claimId", "hostBootId", "expiresAt", "attempt"],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "botId": {
          "$ref": "#/$defs/__schema0"
        },
        "agentId": {
          "$ref": "#/$defs/__schema0"
        },
        "clientMessageId": {
          "$ref": "#/$defs/__schema0"
        },
        "disposition": {
          "type": "string",
          "enum": ["turn_started", "steered", "out_of_band"]
        },
        "turnId": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "submittedRow": {
          "type": "object",
          "properties": {
            "epoch": {
              "$ref": "#/$defs/__schema0"
            },
            "seq": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": ["epoch", "seq"],
          "additionalProperties": false
        }
      },
      "required": ["botId", "agentId", "clientMessageId", "disposition", "turnId", "submittedRow"],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "relativePath": {
          "type": "string",
          "pattern": "^queue-content\\/[a-f0-9]{64}\\.json$"
        },
        "size": {
          "$ref": "#/$defs/__schema1"
        },
        "sha256": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": ["relativePath", "size", "sha256"],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_input",
            "access_denied",
            "conflict",
            "not_found",
            "unsupported",
            "busy",
            "limit_exceeded",
            "outcome_unknown"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "$id": "https://clisbot.com/schemas/proposals/cto-021/v1/journal.schema.json",
  "title": "PROPOSED CTO-021 v1 journal; not implemented wire"
}
