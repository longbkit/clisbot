#!/usr/bin/env bash
set -euo pipefail

IMAGE_HOME="/home/clisbot"

: "${HOME:=$IMAGE_HOME}"
: "${CLISBOT_HOME:=${HOME}/.clisbot}"
: "${CLISBOT_LISTEN:=0.0.0.0:6767}"
: "${CLISBOT_WEB_UI_ENABLED:=true}"
: "${CLISBOT_LOG_LEVEL:=info}"
: "${CLISBOT_LOG_FORMAT:=json}"
: "${CLAUDE_CONFIG_DIR:=${HOME}/.claude}"
: "${CODEX_HOME:=${HOME}/.codex}"
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
: "${XDG_STATE_HOME:=${HOME}/.local/state}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"

export HOME
export CLISBOT_HOME
export CLISBOT_LISTEN
export CLISBOT_WEB_UI_ENABLED
export CLISBOT_LOG_LEVEL
export CLISBOT_LOG_FORMAT
export CLAUDE_CONFIG_DIR
export CODEX_HOME
export XDG_CONFIG_HOME
export XDG_DATA_HOME
export XDG_STATE_HOME
export XDG_CACHE_HOME

ensure_dir() {
  local dir="$1"
  mkdir -p "$dir"
  if [[ "$(id -u)" == "0" ]]; then
    local owner
    owner="$(stat -c "%u" "$dir")"
    if [[ "$owner" == "0" ]]; then
      chown clisbot:clisbot "$dir"
    fi
  fi
}

ensure_dir "$HOME"
ensure_dir "$CLISBOT_HOME"
ensure_dir "$CLAUDE_CONFIG_DIR"
ensure_dir "$CODEX_HOME"
ensure_dir "$XDG_CONFIG_HOME"
ensure_dir "$XDG_DATA_HOME"
ensure_dir "$XDG_STATE_HOME"
ensure_dir "$XDG_CACHE_HOME"

if [[ "$#" -gt 0 ]]; then
  if [[ "$(id -u)" == "0" ]]; then
    exec gosu clisbot "$@"
  fi
  exec "$@"
fi

if [[ -z "${CLISBOT_PASSWORD:-}" ]]; then
  {
    echo "[clisbot] WARNING: CLISBOT_PASSWORD is not set."
    echo "[clisbot] The daemon accepts unauthenticated control connections from any client that can reach it."
    echo "[clisbot] Set CLISBOT_PASSWORD for any published port or network-reachable deployment."
  } >&2
fi

if [[ ! -f /etc/clisbot-server-entry ]]; then
  echo "[clisbot] FATAL: /etc/clisbot-server-entry is missing." >&2
  exit 1
fi

entry="$(cat /etc/clisbot-server-entry)"
echo "[clisbot] starting daemon on ${CLISBOT_LISTEN} with web UI ${CLISBOT_WEB_UI_ENABLED}"
if [[ "$(id -u)" == "0" ]]; then
  exec gosu clisbot node "$entry"
fi
exec node "$entry"
