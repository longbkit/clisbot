*.heapsnapshot

# Legacy root session artifacts; new scratch work belongs in .debug/scratch/<task>/
/.probe-*.mjs
/.hub-*.mjs
/.reviewer-*.txt
/.inspect-bindings.mjs
/.resolve-stuck-perm.mjs
/.set-dev-grok.mjs
/cli-client-id

# Product source must remain trackable even with a global plugins/ ignore.
!/packages/server/src/server/plugins/
!/packages/server/src/server/plugins/**
!/packages/channels/core/src/plugins/
!/packages/channels/core/src/plugins/**

# Versioned Hub examples and fixtures are not local runtime homes.
!/packages/hub/examples/single-repo-team-bot/.clisbot/
!/packages/hub/examples/single-repo-team-bot/.clisbot/**
!/packages/hub/src/config/fixtures/current-project/.clisbot/
!/packages/hub/src/config/fixtures/current-project/.clisbot/**

